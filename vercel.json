{
  "version": 2,
  "installCommand": "pnpm install --frozen-lockfile",
  "buildCommand": "bun --bun vite build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ],
  "redirects": [
    { "source": "/discord", "destination": "https://discord.com/users/1285762174123511850" }
  ]
}
